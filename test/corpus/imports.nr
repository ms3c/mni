// tumia: packages from files, caching, native modules
tumia lib_counter
andika(lib_counter.next(), lib_counter.next())
tumia lib_counter
andika(lib_counter.next(), lib_counter.n)
andika(lib_counter.peek())
secret = "importer's own"
andika(lib_counter.peek(), secret)

tumia hisabati, jsoni
andika(hisabati.floor(2.7), hisabati.max([3, 9, 4]), hisabati.sqrt(16))
andika(jsoni.enkodi({"a": [1, kweli, tupu]}), jsoni.dikodi('{"k": [1, 2.5, "s"]}'))
tumia "lib_counter.nr"
andika(lib_counter.next())
