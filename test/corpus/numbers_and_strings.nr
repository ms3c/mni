// numbers and strings
andika(7 / 2, 6 / 2, -7 / 2, 7 % 3, -7 % 3, 7 % -1, 2 ** 10, 2 ** -2, 2.5 ** 2)
andika(1 + 2.5, 3 * 0.5, 10 / 4.0, 5.0 % 3)
andika(9223372036854775807 - 1, 9223372036854775807 + 1, 3037000499 * 3037000499, 3037000500 * 3037000500)
andika(1 == 1.0, 1 < 1.5, "a" < "b", "abc" == "abc", [1, 2] == [1, 2], {"a": 1} == {"a": 1})
andika(0.1 + 0.2, 1000000.0, 10.0 ** 21, 10.0 ** -7)
andika("ab" + "cd", "ab" * 3, 2 * "xy", "é" * 2)
s = "hello world"
andika(s.idadi(), s.herufikubwa(), "ÀB".herufindogo(), s.gawa(), "a,b,,c".gawa(","), "abc".gawa(""))
andika(s[0], s[-1], s[99], s[4])
andika("ni" ktk "nuru nipo", "x" ktk "abc")
andika(-5, - -5, +3, !kweli)
andika(aina(1), aina(1.5), aina("s"), aina(kweli), aina(tupu), aina([]), aina({}), aina(andika))
